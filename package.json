{
  "name": "idev-admin",
  "private": true,
  "version": "0.7.0",
  "type": "module",
  "description": "IDEV : ADMIN Ξ²β‚¬β€ an incremental/idle game about shipping software.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:motion": "npm run build && vitest run src/__tests__/motion.test.ts",
    "simulate": "tsx tools/balance-sim.ts",
    "check:workflows": "tsx tools/check-workflows.ts",
    "semver:check": "tsx tools/semver-engine.ts",
    "semver:bump": "tsx tools/semver-engine.ts --apply",
    "verify": "npm run lint && npm run typecheck && npm run check:workflows && npm run build && npm run test"
  },
  "dependencies": {
    "break_infinity.js": "^2.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "jsdom": "^30.1.2",
    "oxlint": "^1.81.0",
    "postcss": "^8.5.29",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
